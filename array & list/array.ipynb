   "source": [
    "#### Find the largest element of the list"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "44563bb6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "54\n"
     ]
    }
   ],
   "source": [
    "numbers = [ 2, 5, 23, 54, 3, 3, 5]\n",
    "\n",
    "largest = numbers[0]\n",
    "\n",
    "for i in numbers[1:]:\n",
    "    if largest < i:\n",
    "        largest = i\n",
    "print(largest)\n",
    "\n"
   ]
  }
